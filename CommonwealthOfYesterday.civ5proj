<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Deploy" ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Default</Configuration>
    <ProjectGuid>{A2E37EE2-9E0A-4F53-A86E-E952BEB88F5A}</ProjectGuid>
    <Name>The Commonwealth of Yesterday</Name>
    <SafeName>The Commonwealth of Yesterday</SafeName>
    <Guid>c9f981d8-e712-4dc8-9db4-4b63980b81ae</Guid>
    <Teaser>Carry old friends and treasured memories into the future.</Teaser>
    <Description>A Vox Populi civilization led by The Child We Were. Preserve Old Friends, age Childhood Bedrooms, and spend Memories on powerful Reminiscences.</Description>
    <Authors>ThatOneYi</Authors>
    <AssemblyName>CommonwealthOfYesterday</AssemblyName>
    <RootNamespace>CommonwealthOfYesterday</RootNamespace>
    <Civ5Path>C:\Program Files (x86)\Steam\steamapps\common\Sid Meier's Civilization V</Civ5Path>
    <Civ5UserPath>C:\Users\ThatOneYi\Documents\My Games\Sid Meier's Civilization 5</Civ5UserPath>
    <AffectsSavedGames>true</AffectsSavedGames>
    <MinCompatibleSaveVersion>0</MinCompatibleSaveVersion>
    <SupportsSinglePlayer>true</SupportsSinglePlayer>
    <SupportsMultiplayer>false</SupportsMultiplayer>
    <SupportsHotSeat>false</SupportsHotSeat>
    <SupportsMac>false</SupportsMac>
    <ReloadAudioSystem>false</ReloadAudioSystem>
    <ReloadLandmarkSystem>false</ReloadLandmarkSystem>
    <ReloadStrategicViewSystem>false</ReloadStrategicViewSystem>
    <ReloadUnitSystem>false</ReloadUnitSystem>
    <ModActions>
      <Action>
        <Set>OnModActivated</Set>
        <Type>UpdateDatabase</Type>
        <FileName>SQL/00_Commonwealth_Core.sql</FileName>
      </Action>
      <Action>
        <Set>OnModActivated</Set>
        <Type>UpdateDatabase</Type>
        <FileName>SQL/10_Commonwealth_Text.sql</FileName>
      </Action>
    </ModActions>
    <ModContent>
      <Content>
        <Type>InGameUIAddin</Type>
        <Name>Commonwealth Gameplay</Name>
        <Description>Loads Memories, Old Friends, and Childhood Bedroom systems.</Description>
        <FileName>Lua/CommonwealthLoader.lua</FileName>
      </Content>
      <Content>
        <Type>InGameUIAddin</Type>
        <Name>Memories Panel</Name>
        <Description>Displays Reminiscence controls and the Old Friends Ledger.</Description>
        <FileName>UI/CommonwealthPanel.xml</FileName>
      </Content>
    </ModContent>
    <ModVersion>1</ModVersion>
    <Stability>Alpha</Stability>
    <ModReferences />
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Default' ">
    <OutputPath>.</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="SQL\00_Commonwealth_Core.sql">
      <SubType>SQL</SubType>
      <ImportIntoVFS>False</ImportIntoVFS>
    </Content>
    <Content Include="SQL\10_Commonwealth_Text.sql">
      <SubType>SQL</SubType>
      <ImportIntoVFS>False</ImportIntoVFS>
    </Content>
    <Content Include="Lua\CommonwealthLoader.lua">
      <SubType>Lua</SubType>
      <ImportIntoVFS>False</ImportIntoVFS>
    </Content>
    <Content Include="Lua\CommonwealthCore.lua">
      <SubType>Lua</SubType>
      <ImportIntoVFS>True</ImportIntoVFS>
    </Content>
    <Content Include="UI\CommonwealthPanel.xml">
      <SubType>Lua</SubType>
      <ImportIntoVFS>False</ImportIntoVFS>
    </Content>
    <Content Include="UI\CommonwealthPanel.lua">
      <SubType>Lua</SubType>
      <ImportIntoVFS>False</ImportIntoVFS>
    </Content>
    <Content Include="README.md"><ImportIntoVFS>False</ImportIntoVFS></Content>
    <Content Include="PATCH_NOTES.md"><ImportIntoVFS>False</ImportIntoVFS></Content>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="SQL\" />
    <Folder Include="Lua\" />
    <Folder Include="UI\" />
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath)\Firaxis\ModBuddy\Civ5Mod.targets" />
</Project>
